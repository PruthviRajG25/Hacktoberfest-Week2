# =================================================================
# Open List Environment Configuration
# =================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# -----------------------------------------------------------------
# AI Inference Provider Configuration
# -----------------------------------------------------------------
# Options: 'ollama' or 'hosted_openai_compatible'
AI_PROVIDER=ollama

# Local Ollama Settings (Mode A: Local Development)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Remote Hosted Open-Weight Endpoint (Mode B: Render Demo)
# Any OpenAI-compatible endpoint hosting open-weight models (e.g., Together AI, Groq, vLLM, RunPod)
OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPATIBLE_API_KEY=your_optional_api_key_here
OPENAI_COMPATIBLE_MODEL=google/gemma-2-9b-it

# -----------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# -----------------------------------------------------------------
# Example Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=open_list_db

# -----------------------------------------------------------------
# Vector Search & Embeddings Configuration
# -----------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=gemma3:1b
VECTOR_SEARCH_INDEX_NAME=vector_index
